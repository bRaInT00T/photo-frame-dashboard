# Copy to .env and fill in. Never commit .env.

# Google Calendar → Settings → (the calendar) → Integrate calendar → "Secret address in iCal format".
# One variable per entry in config.json "calendars".
GCAL_FAMILY=

# Immich (same server): Account Settings → API Keys.
# Permissions: asset.read, asset.view, memory.read, face.read (face-centred portrait crops) (+ album.read only if config.json uses "source": "album").
IMMICH_URL=http://your-server-ip:2283
IMMICH_API_KEY=

# Home Assistant: a non-admin user for the frame → Profile → Security → Long-lived access token.
HA_TOKEN=
